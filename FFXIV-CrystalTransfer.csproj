<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- 本机使用 XIVLauncherCN（DailyRoutines 改版 Dalamud v15），覆盖 SDK 默认的 XIVLauncher 路径 -->
    <DalamudLibPath>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
    <AssemblySearchPaths>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\;$(AssemblySearchPaths)</AssemblySearchPaths>

    <!-- Manifest fields（参考 SamplePlugin 模板） -->
    <Version>1.0.0.0</Version>
    <Author>Sparrow-prime</Author>
    <Name>FFXIV-CrystalTransfer</Name>
    <Punchline>Transfer selected crystals from your inventory to your retainers automatically.</Punchline>
    <Description>自动将背包中的水晶（碎晶/水晶/晶簇）存入雇员背包。在传唤铃旁执行 /crystaltransfer auto 即可逐个雇员存入勾选的水晶。</Description>
    <RepoUrl>https://github.com/Sparrow-prime/FFXIV-CrystalTransfer</RepoUrl>
    <Tags>crystal;retainer;transfer;inventory;utility</Tags>

    <Authors>Sparrow-prime</Authors>
    <AssemblyName>FFXIV-CrystalTransfer</AssemblyName>
    <RootNamespace>FFXIVCrystalTransfer</RootNamespace>
    <InternalName>CrystalTransfer</InternalName>
    <ApplicableVersion>any</ApplicableVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 显式引用 XIVLauncherCN（DailyRoutines 改版）提供的 ImGui 绑定 -->
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\Dalamud.Bindings.ImGui.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImPlot"><HintPath>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\Dalamud.Bindings.ImPlot.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGuizmo"><HintPath>$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\Dalamud.Bindings.ImGuizmo.dll</HintPath></Reference>
  </ItemGroup>
</Project>
